# Copia este archivo a `.env` para cambiar los valores con que `docker compose` levanta el sistema.
# `.env` no se sube al repositorio.

# Contraseña del usuario `rockstar` de PostgreSQL. Solo se aplica al crear la base:
# para cambiarla después hay que borrar el volumen (`docker compose down --volumes`).
POSTGRES_PASSWORD=rockstar_dev

# Carga cuentas, productos y pedidos de demostración si la base está vacía.
# Las contraseñas de esas cuentas son públicas: usar `false` fuera de desarrollo.
SEMBRAR_DEMO=true

# Orígenes que pueden llamar a la API desde un navegador, separados por coma.
# Vacío acepta cualquiera. La app del contenedor no lo necesita: comparte origen con la API.
CORS_ORIGENES=

# Clave de la API de Claude (https://console.anthropic.com) para el asesor de inversión
# del panel del Gerente. Es un servicio de pago por uso: cada consulta consume saldo de
# esa cuenta. Vacía, el asesor queda desactivado y todo lo demás funciona igual.
ANTHROPIC_API_KEY=

# Bodega desde donde sale la ruta de reparto de la app de bodega: nombre, dirección y
# coordenadas en grados decimales (en Google Maps, clic derecho sobre el lugar). Vacías,
# la ruta parte de una ubicación de ejemplo en la Plaza de Armas de Santiago.
BODEGA_NOMBRE=
BODEGA_DIRECCION=
BODEGA_LAT=
BODEGA_LON=
# Correo de contacto para los servicios de mapas de OpenStreetMap (Nominatim y OSRM), que
# piden identificarse. Son gratuitos y con límites de uso: para operar a diario conviene
# un servidor propio o contratado, en GEOCODIFICADOR_URL y RUTAS_URL.
MAPAS_CONTACTO=

# Puertos publicados en este equipo.
APP_PUERTO=8080
TIENDA_PUERTO=8081
API_PUERTO=3000
DB_PUERTO=5432
